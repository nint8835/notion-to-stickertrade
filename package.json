{
  "name": "notion-to-stickertrade",
  "version": "1.0.0",
  "description": "Mirror a Notion sticker database to Sticker Trade.",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "start:live": "STICKERTRADE_MODE=live npm start",
    "test": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "cli-progress": "^3.12.0",
    "dotenv": "^16.0.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.0",
    "@types/node": "^18.16.0",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  }
}
